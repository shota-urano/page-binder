{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "make lint",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "make verify-fast",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ]
  }
}