<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".spike.capture.MediaProjectionSpikeActivity"
            android:exported="true"
            android:theme="@style/Theme.PageBinder" />
        <service
            android:name=".spike.capture.MediaProjectionSpikeService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".spike.saf.SafPickerSpikeActivity"
            android:exported="false" />
        <!--
          debug 専用の書き出し画面プレビュー。ランチャーには出さず `adb shell am start` で開く。
          LAUNCHER を付けるとアプリの入口が2つになり、MediaProjection の「1つのアプリ」共有先を
          PageBinder にしたときにこちらが起動して書き出しプレビューが前面に出る
          （pagebinder-fu6 の実機検証で書籍詳細に戻れない誤検証の原因になった）。
          他のプレビューと同じ扱いに揃える
        -->
        <activity
            android:name=".preview.ExportScreenPreviewActivity"
            android:exported="true"
            android:label="@string/export_preview_label"
            android:theme="@style/Theme.PageBinder" />
        <!-- debug 専用のページ一覧プレビュー。ランチャーには出さず `adb shell am start` で開く -->
        <activity
            android:name=".preview.PageListScreenPreviewActivity"
            android:exported="true"
            android:label="@string/page_list_preview_label"
            android:theme="@style/Theme.PageBinder" />
        <!-- debug 専用のOCR編集画面プレビュー。ランチャーには出さず `adb shell am start` で開く -->
        <activity
            android:name=".preview.OcrEditScreenPreviewActivity"
            android:exported="true"
            android:label="@string/ocr_edit_preview_label"
            android:theme="@style/Theme.PageBinder" />
        <!-- debug 専用の回転・切り取り編集プレビュー。ランチャーには出さず `adb shell am start` で開く -->
        <activity
            android:name=".preview.PageEditScreenPreviewActivity"
            android:exported="true"
            android:label="@string/page_edit_preview_label"
            android:theme="@style/Theme.PageBinder" />
        <!-- debug 専用の連続撮影フローティングUIプレビュー。ランチャーには出さず `adb shell am start` で開く -->
        <activity
            android:name=".preview.FloatingUiPreviewActivity"
            android:exported="true"
            android:label="@string/floating_ui_preview_label"
            android:theme="@style/Theme.PageBinder" />
        <!-- debug 専用の重複・黒画面の確認プレビュー。ランチャーには出さず `adb shell am start` で開く -->
        <activity
            android:name=".preview.DuplicateReviewScreenPreviewActivity"
            android:exported="true"
            android:label="@string/duplicate_review_preview_label"
            android:theme="@style/Theme.PageBinder" />
    </application>

</manifest>
